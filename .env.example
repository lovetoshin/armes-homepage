# ──────────────────────────────────────────────────────────
# ARMES 환경 변수 템플릿
# 이 파일을 .env.local 로 복사하고 실제 값을 입력하세요
# cp .env.example .env.local
# ──────────────────────────────────────────────────────────

# ── 사이트 URL ──
NEXT_PUBLIC_SITE_URL=https://www.armes.co.kr

# ── 이메일 발송 (SMTP — 문의폼/출시알림 실제 전송) ──
# 아래 4개를 설정하면 support.armes@gmail.com로 이메일이 실제로 발송됩니다
# Gmail: smtp.gmail.com:587 / 앱 비밀번호 사용
# Naver: smtp.naver.com:587
# 가비아: 가비아 이메일 SMTP 설정 참고
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@email.com
SMTP_PASS=your-app-password

# ── 수신 이메일 (기본값: support.armes@gmail.com) ──
CONTACT_TO=support.armes@gmail.com

# ── 분석 (선택) ──
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
