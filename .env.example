# ──────────────────────────────────────────────────────────
# ARMES 환경 변수 템플릿
# 이 파일을 .env.local 로 복사하고 실제 값을 입력하세요
# cp .env.example .env.local
# ──────────────────────────────────────────────────────────

# ── 사이트 URL (배포 도메인으로 변경) ──
NEXT_PUBLIC_SITE_URL=https://armes.co.kr

# ── 문의 폼 알림 (선택 — 설정 시 Webhook으로 문의 알림 전송) ──
# Slack / Discord / Make(Integromat) / n8n 등의 Webhook URL
CONTACT_WEBHOOK_URL=

# ── 이메일 발송 (Nodemailer, 선택) ──
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=noreply@armes.co.kr
# SMTP_TO=contact@armes.co.kr

# ── 분석 (선택) ──
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTAG_ID=GTM-XXXXXXX
